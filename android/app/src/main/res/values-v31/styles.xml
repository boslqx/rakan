<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces windowBackground with the system splash screen
         (launcher icon on a theme colour) while the app starts, when the OS's
         Dark Mode setting is off. Make it a plain dark field to match the
         Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
